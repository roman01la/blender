{
  "name": "blender-rocks",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blender.rocks", "custom_domain": true }],
  "assets": {
    "directory": "dist/public",
    "run_worker_first": [
      "/blender.wasm", "/blender-assets.data", "/blender-cycles-webgpu.data",
      "/runtime/*/blender.wasm", "/runtime/*/blender-assets.data", "/runtime/*/blender-cycles-webgpu.data"
    ]
  },
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "blender-rocks-releases" }]
}
