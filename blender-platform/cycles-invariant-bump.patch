+static bool displacement_bump_has_uniform_taps(const ShaderOutput &source)
+{
+  ShaderNode &node = *source.parent;
+  /* constant_fold() restores a folded displacement through a Color node and
+   * its automatic Color-to-Vector conversion, a stack alias in stock SVM. */
+  const ShaderNode *color = &node;
+  if (node.special_type == SHADER_SPECIAL_TYPE_AUTOCONVERT &&
+      source.type() == SocketType::VECTOR && node.inputs.size() == 1)
+  {
+    const ShaderOutput *input = node.inputs[0]->link;
+    if (input && input->type() == SocketType::COLOR) {
+      color = input->parent;
+    }
+  }
+  if (color->type == ColorNode::get_node_type()) {
+    return isfinite_safe(static_cast<const ColorNode &>(*color).get_value());
+  }
+  if (node.type == DisplacementNode::get_node_type()) {
+    const auto &displacement = static_cast<const DisplacementNode &>(node);
+    const ShaderOutput *normal = node.input("Normal")->link;
+    /* The stock Geometry normals do not use the bump sample's position or UV.
+     * The normal and vector transforms use the same object for all three taps. */
+    const bool uniform_normal = !normal ||
+                                (normal->parent->type == GeometryNode::get_node_type() &&
+                                 (normal->name() == "Normal" || normal->name() == "True Normal"));
+    return uniform_normal && !node.input("Height")->link && !node.input("Midlevel")->link &&
+           !node.input("Scale")->link &&
+           isfinite_safe((displacement.get_height() - displacement.get_midlevel()) *
+                         displacement.get_scale());
+  }
+  if (node.type == VectorDisplacementNode::get_node_type()) {
+    const auto &displacement = static_cast<const VectorDisplacementNode &>(node);
+    /* This SVM operation fetches its tangent at the original hit. The stock
+     * vector displacement opcode has no bump offset and uses the same tangent
+     * and transform for all three taps. */
+    return !check_node_inputs_has_links(&node) &&
+           isfinite_safe((displacement.get_vector() - make_float3(displacement.get_midlevel())) *
+                         displacement.get_scale());
+  }
+  return false;
+}
