 /** \name Rendering utility functions
  * \{ */
 
+#ifdef __EMSCRIPTEN__
+bool render_uses_scene_or_compositor(const Scene &scene)
+{
+  if (!scene.ed) {
+    return false;
+  }
+
+  bool needs_editor_gpu = false;
+  foreach_strip(&scene.ed->seqbase, [&](const Strip *strip) {
+    /* Scan nested meta strips and include muted strips, which can become active in later frames. */
+    if (ELEM(strip->type, STRIP_TYPE_SCENE, STRIP_TYPE_COMPOSITOR)) {
+      needs_editor_gpu = true;
+      return false;
+    }
+    for (const StripModifierData &modifier : strip->modifiers) {
+      if (modifier.type == eSeqModifierType_Compositor) {
+        needs_editor_gpu = true;
+        return false;
+      }
+    }
+    return true;
+  });
+  return needs_editor_gpu;
+}
