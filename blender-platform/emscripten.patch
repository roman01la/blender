+namespace curves {
+
+struct StripIndices {
+  [[storage(0, read)]] const int (&indirection_buf)[];
+  [[storage(1, write)]] uint (&index_buf)[];
+  [[push_constant]] int curves_start;
+  [[push_constant]] int curves_count;
+  [[push_constant]] uint vertex_per_segment;
+  [[push_constant]] bool is_cylinder;
+};
+
+/* Generate vertex IDs for the same procedural shader, marking the gaps with
+ * the hardware strip restart index. */
+[[compute, local_size(CURVES_PER_THREADGROUP)]] void eval_strip_indices(
+    [[resource_table]] StripIndices &srt, [[global_invocation_id]] const uint3 global_id)
+{
+  if (global_id.x >= uint(srt.curves_count)) {
+    return;
+  }
+
+  uint segment = global_id.x + uint(srt.curves_start);
+  uint first_vertex = segment * srt.vertex_per_segment;
+  uint first_index = first_vertex + (srt.is_cylinder ? segment / 2u : 0u);
+  bool restart_segment = srt.indirection_buf[segment] == INT_MAX;
+
+  /* A hardware restart resets parity. Match the original odd cylinder strips
+   * with one degenerate leading triangle, preserving the original diagonals. */
+  if (srt.is_cylinder && (segment & 1u) != 0u) {
+    srt.index_buf[first_index] = restart_segment ? ~0u : first_vertex;
+    first_index++;
+  }
+  for (uint local_vertex = 0u; local_vertex < srt.vertex_per_segment; local_vertex++) {
+    uint vertex = first_vertex + local_vertex;
+    bool restart = restart_segment ||
+                   (srt.is_cylinder && local_vertex == srt.vertex_per_segment - 1u);
+    srt.index_buf[first_index + local_vertex] = restart ? ~0u : vertex;
+  }
+}
+
+}  // namespace curves
+
+PipelineCompute draw_curves_strip_indices(curves::eval_strip_indices);
