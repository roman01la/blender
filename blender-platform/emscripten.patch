+  double delay = BLI_timer_delay_get(now, 0.1);
+  if (const wmWindowManager *wm = CTX_wm_manager(C)) {
+    for (const wmTimer &timer : wm->runtime->timers) {
+      if (!timer.sleep && !(timer.flags & WM_TIMER_TAGGED_FOR_REMOVAL)) {
+        delay = std::min(delay, timer.time_next - now);
