+#ifdef __EMSCRIPTEN__
+void ShaderModule::prewarm_material_preview(const View3D *view)
+{
+  static_shaders_wait_ready(viewport_core_shaders);
+  static_shader_get(LOOKDEV_DISPLAY);
+  static_shader_get(LOOKDEV_COPY_WORLD);
+  static_shader_get(TRANSPARENCY_RESOLVE);
+  static_shader_get(SHADOW_TILEMAP_TAG_UPDATE_PROPAGATE);
+  static_shader_get(VERTEX_COPY);
+  DRW_shader_draw_view_finalize_get();
+
+  /* The viewport's material instances can be created after the editor has been idle
+   * for a while. Keep their compiled passes in the shared cache until engine shutdown. */
+  auto retain_pass = [&](GPUMaterial *material) {
+    if (material && GPU_material_status(material) == GPU_MAT_SUCCESS) {
+      GPUPass *pass = GPU_material_get_pass(material);
+      if (pass && !prewarmed_material_preview_passes_.contains(pass)) {
+        GPU_pass_acquire(pass);
+        prewarmed_material_preview_passes_.append(pass);
+      }
+    }
+  };
+
+  blender::Material *surface = reinterpret_cast<blender::Material *>(BKE_id_copy_ex(
+      nullptr, &BKE_material_default_surface()->id, nullptr, LIB_ID_COPY_LOCALIZE));
+  for (eMaterialPipeline pipeline : {MAT_PIPE_PREPASS_DEFERRED,
+                                     MAT_PIPE_PREPASS_DEFERRED_VELOCITY,
+                                     MAT_PIPE_DEFERRED,
+                                     MAT_PIPE_SHADOW})
+  {
+    retain_pass(material_shader_get(
+        surface, surface->nodetree, pipeline, MAT_GEOM_MESH, false, nullptr));
+  }
+
+  for (blender::Material *sphere : {MaterialModule::create_lookdev_diffuse_material(),
+                                   MaterialModule::create_lookdev_metallic_material()})
+  {
+    retain_pass(material_shader_get(
+        sphere, sphere->nodetree, MAT_PIPE_FORWARD, MAT_GEOM_MESH, false, surface));
+    BKE_id_free(nullptr, sphere);
+  }
+  BKE_id_free(nullptr, surface);
+
+  /* Compile the studio HDRI graph used by the startup viewport. */
+  const LookdevParameters lighting(view);
+  if (view && !lighting.show_scene_world) {
+    LookdevWorld lookdev;
+    lookdev.sync(lighting);
+    blender::World *world = lookdev.world_get();
+    retain_pass(world_shader_get(world, world->nodetree, MAT_PIPE_DEFERRED, false));
+  }
+}
+#endif
