+
+static bool export_resident_film(const uint32_t id,
+                                 RenderBuffers &buffers,
+                                 const DenoiseParams &params,
+                                 const int samples,
+                                 const bool denoise)
+{
+  const BufferParams &film = buffers.params;
+  const int albedo = (params.passes & DENOISER_PASS_ALBEDO) != 0 ?
+                         film.get_pass_offset(PASS_DENOISING_ALBEDO) :
+                         PASS_UNUSED;
+  const int normal = (params.passes & DENOISER_PASS_NORMAL) != 0 ?
+                         film.get_pass_offset(PASS_DENOISING_NORMAL) :
+                         PASS_UNUSED;
+  const bool high = params.quality == DENOISER_QUALITY_HIGH;
+  const bool fast = params.quality == DENOISER_QUALITY_FAST;
+  const bool clean_aux = params.prefilter != DENOISER_PREFILTER_FAST;
+  const bool prefilter = denoise && params.prefilter == DENOISER_PREFILTER_ACCURATE;
+  const std::array<const char *, 3> models{
+      prefilter && albedo != PASS_UNUSED ?
+          cycles_webgpu_oidn_model(false, true, false, false, high, fast) :
+          nullptr,
+      prefilter && normal != PASS_UNUSED ?
+          cycles_webgpu_oidn_model(false, false, true, false, high, fast) :
+          nullptr,
+      denoise ? cycles_webgpu_oidn_model(
+                    true, albedo != PASS_UNUSED, normal != PASS_UNUSED, clean_aux, high, fast) :
+                nullptr};
+  const WebGPUOIDNFilmOutput output{id,
+                                   uint32_t(samples),
+                                   uint32_t(film.get_pass_offset(PASS_SAMPLE_COUNT)),
+                                   uint32_t(film.get_pass_offset(PASS_COMBINED)),
+                                   uint32_t(film.get_pass_offset(PASS_COMBINED, PassMode::DENOISED)),
+                                   uint32_t(albedo),
+                                   uint32_t(normal)};
+  std::array<double, 3> times{};
+  if (!cycles_webgpu_oidn_finish_film(output, models, buffers.buffer.data(), times)) {
+    cycles_webgpu_oidn_drop_film(id);
+    return false;
+  }
+  constexpr std::array<const char *, 3> passes = {"albedo", "normal", "color"};
+  for (size_t i = 0; i < models.size(); i++) {
+    if (models[i]) {
+      LOG_INFO << "Cycles OIDN WebGPU " << passes[i] << ": model " << models[i] << ", execute "
+               << times[i] << " s";
+    }
+  }
+  LOG_INFO << "Cycles WebGPU resident film export " << film.width << " x " << film.height;
+  return true;
+}
