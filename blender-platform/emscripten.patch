diff --git a/source/blender/draw/engines/overlay/shaders/overlay_grease_pencil_selection_vert.glsl b/source/blender/draw/engines/overlay/shaders/overlay_grease_pencil_selection_vert.glsl
new file mode 100644
index 00000000..2ad3d0d2
--- /dev/null
+++ b/source/blender/draw/engines/overlay/shaders/overlay_grease_pencil_selection_vert.glsl
@@ -0,0 +1,45 @@
+/* SPDX-FileCopyrightText: 2016-2023 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "infos/overlay_edit_mode_infos.hh"
+
+VERTEX_SHADER_CREATE_INFO(overlay_grease_pencil_selection)
+
+#include "draw_model_lib.glsl"
+#include "draw_view_clipping_lib.glsl"
+#include "draw_view_lib.glsl"
+#include "gpu_shader_attribute_load_lib.glsl"
+#include "gpu_shader_index_load_lib.glsl"
+
+void main()
+{
+  /* Draw the input strip as a line list so each invocation can test both endpoints. */
+  uint endpoint = uint(gl_VertexID) & 1u;
+  uint segment = uint(gl_VertexID) >> 1u;
+  uint index0 = gpu_index_load(segment);
+  uint index1 = gpu_index_load(segment + 1u);
+  /* gpu_index_load applies the buffer's base index even to the restart value. */
+  uint restart_index = (gpu_index_16bit ? 0xFFFFu : 0xFFFFFFFFu) + uint(gpu_index_base_index);
+  /* Both vertices of each rejected segment stay outside the same clip plane. */
+  gl_Position = float4(2.0f, 2.0f, 0.0f, 1.0f);
+  if (!gpu_index_no_buffer && (index0 == restart_index || index1 == restart_index)) {
+    return;
+  }
+
+  float selection0 = selection[gpu_attr_load_index(index0, gpu_attr_1)];
+  float selection1 = selection[gpu_attr_load_index(index1, gpu_attr_1)];
+  if (selection0 <= 0.0f || selection1 <= 0.0f) {
+    return;
+  }
+
+  uint vertex_index = endpoint == 0u ? index0 : index1;
+  float vertex_selection = endpoint == 0u ? selection0 : selection1;
+  float3 local_pos = gpu_attr_load_float3(pos, gpu_attr_0, vertex_index);
+  float3 world_pos = drw_point_object_to_world(local_pos);
+  gl_Position = drw_point_world_to_homogenous(world_pos);
+  final_color = mix(theme.colors.gpencil_wire_edit,
+                    theme.colors.gpencil_vertex_select,
+                    vertex_selection);
+  view_clipping_distances(world_pos);
+}
