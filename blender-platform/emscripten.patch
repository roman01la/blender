+#ifdef __EMSCRIPTEN__
+void GHOST_ISystem::requestWebGPUForStartup(std::function<void(const char *)> callback)
+{
+  auto complete = [callback = std::move(callback)](const char *error) mutable {
+    struct Completion {
+      std::function<void(const char *)> callback;
+      std::string error;
+    };
+    auto *completion = new Completion{std::move(callback), error ? error : ""};
+    /* Resume outside Emdawn's promise callback, including on synchronous completion. */
+    emscripten_async_call(
+        [](void *data) {
+          auto completion = std::unique_ptr<Completion>(static_cast<Completion *>(data));
+          completion->callback(completion->error.empty() ? nullptr : completion->error.c_str());
+        },
+        completion,
+        0);
+  };
+  if (auto *system = dynamic_cast<GHOST_SystemWeb *>(this)) {
+    system->requestWebGPU(std::move(complete));
+  }
+  else {
+    complete("The browser GHOST system is unavailable.");
+  }
+}
+#endif
